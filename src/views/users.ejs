<!doctype html><html lang="en" class="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CPM Users</title><link rel="stylesheet" href="/shared/css/master-devices.css"><link rel="stylesheet" href="/shared/ico/icons.css"><link rel="stylesheet" href="/shared/css/normalize.css"></head><body>
<nav><span><%= name %>&ensp;<i class="icmn-user3"></i></span><span onclick="location='/dashboard/settings'">Settings&ensp;<i class="icmn-cog"></i></span><span onclick="location='/logout'">Logout&ensp;<i class="icmn-exit3"></i></span><span>&nbsp;</span></nav><%- include('partials/sidebar.ejs') %><div class="main"><%- include('partials/logobar.ejs') %><div class="internal"><h1>Users</h1>
<table><thead><tr><th>Username</th><th>Name</th><th>Role</th><th>Enabled</th><th>Action</th></tr></thead><tbody><% accounts.forEach(account=>{ %><tr><td><%= account.username %></td><td><%= account.name || account.username %></td><td><%= account.permissions === '*' ? 'Administrator' : 'User' %></td><td><%= account.enabled ? 'Yes' : 'No' %></td><td><button type="button" onclick='editUser(<%- JSON.stringify(account) %>)'>Edit</button> <% if(account.username !== username){ %><button type="button" onclick='deleteUser(<%- JSON.stringify(account.username) %>)'>Delete</button><% } %></td></tr><% }) %></tbody></table>
<h2>Create or modify user</h2><form id="userForm"><p><label>Username <input id="editUsername" required pattern="[A-Za-z0-9._-]{3,64}"></label></p><p><label>Name <input id="editName" required></label></p><p><label>New password <input id="editPassword" type="password" minlength="10" autocomplete="new-password"></label></p><p><label>Confirm password <input id="editConfirmPassword" type="password" minlength="10" autocomplete="new-password"></label></p><p><label><input id="editAdmin" type="checkbox"> Administrator</label> <label><input id="editEnabled" type="checkbox" checked> Enabled</label></p><button>Save user</button> <span id="status" role="status"></span></form></div></div>
<script>function editUser(user){editUsername.value=user.username;editUsername.readOnly=true;editName.value=user.name||user.username;editAdmin.checked=user.permissions==='*';editEnabled.checked=user.enabled;editPassword.value='';editConfirmPassword.value='';} async function deleteUser(username){if(!confirm('Delete '+username+'?'))return;const r=await fetch('/api/users/'+encodeURIComponent(username),{method:'DELETE'});const j=await r.json();if(r.ok)location.reload();else status.textContent=j.message;} userForm.addEventListener('submit',async(e)=>{e.preventDefault();if(editPassword.value!==editConfirmPassword.value){status.textContent='Passwords do not match.';return;}const r=await fetch('/api/users',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:editUsername.value,name:editName.value,password:editPassword.value,confirmPassword:editConfirmPassword.value,permissions:editAdmin.checked?'*':'',enabled:editEnabled.checked})});const j=await r.json();if(r.ok)location.reload();else status.textContent=j.message;});</script></body></html>
