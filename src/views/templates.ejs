<!doctype html><html lang="en" class="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CPM Templates</title><link rel="stylesheet" href="/shared/css/master-devices.css"><link rel="stylesheet" href="/shared/ico/icons.css"><link rel="stylesheet" href="/shared/css/normalize.css"></head><body>
<nav><span><%= name %>&ensp;<i class="icmn-user3"></i></span><span onclick="location='/dashboard/settings'">Settings&ensp;<i class="icmn-cog"></i></span><span onclick="location='/logout'">Logout&ensp;<i class="icmn-exit3"></i></span><span>&nbsp;</span></nav><%- include('partials/sidebar.ejs') %><div class="main"><%- include('partials/logobar.ejs') %><div class="internal"><h1>Device templates</h1><p>Templates supply reusable phone-setting values. Device-level changes remain unique to that device.</p>
<table><thead><tr><th>Name</th><th>Description</th><th>Settings</th><th>Action</th></tr></thead><tbody><% templates.forEach(template=>{ %><tr><td><%= template.name %></td><td><%= template.description %></td><td><%= Object.keys(template.phoneSettings).length %></td><td><button onclick='editTemplate(<%- JSON.stringify(template) %>)'>Edit</button> <button onclick='deleteTemplate(<%- JSON.stringify(template.uuid) %>)'>Delete</button></td></tr><% }) %></tbody></table>
<h2>Build template</h2><form id="templateForm"><input id="uuid" type="hidden"><p><label>Name <input id="templateName" required></label></p><p><label>Description <input id="description"></label></p><p><label>Phone settings (JSON object)<br><textarea id="phoneSettings" rows="14" cols="70" spellcheck="false">{}</textarea></label></p><button>Save template</button> <span id="status" role="status"></span></form></div></div>
<script>function editTemplate(t){uuid.value=t.uuid;templateName.value=t.name;description.value=t.description||'';phoneSettings.value=JSON.stringify(t.phoneSettings,null,2);} async function deleteTemplate(id){if(!confirm('Delete this template?'))return;const r=await fetch('/api/templates/'+encodeURIComponent(id),{method:'DELETE'});if(r.ok)location.reload();else status.textContent=(await r.json()).message;} templateForm.addEventListener('submit',async(e)=>{e.preventDefault();let settings;try{settings=JSON.parse(phoneSettings.value)}catch(error){status.textContent='Invalid JSON: '+error.message;return}const r=await fetch('/api/templates',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({uuid:uuid.value||undefined,name:templateName.value,description:description.value,phoneSettings:settings})});const j=await r.json();if(r.ok)location.reload();else status.textContent=j.message;});</script></body></html>
