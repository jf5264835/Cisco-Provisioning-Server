<!doctype html><html lang="en" class="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CPM Templates</title><link rel="stylesheet" href="/shared/css/master-devices.css"><link rel="stylesheet" href="/shared/ico/icons.css"><link rel="stylesheet" href="/shared/css/normalize.css"></head><body>
<nav><span><%= name %>&ensp;<i class="icmn-user3"></i></span><span onclick="location='/dashboard/settings'">Settings&ensp;<i class="icmn-cog"></i></span><span onclick="location='/logout'">Logout&ensp;<i class="icmn-exit3"></i></span><span>&nbsp;</span></nav><%- include('partials/sidebar.ejs') %><div class="main"><%- include('partials/logobar.ejs') %><div class="internal"><h1>Device templates</h1><p>Templates supply reusable phone-setting values. Unset values are omitted and device-level changes remain unique to that device.</p><p><a href="/dashboard/addDevice?astat=template">Create Template</a></p>
<table><thead><tr><th>Name</th><th>Description</th><th>Settings</th><th>Action</th></tr></thead><tbody><% templates.forEach(template=>{ %><tr><td><%= template.name %></td><td><%= template.description %></td><td><%= Object.keys(template.phoneSettings).length %></td><td><a title="Edit Template" href="/dashboard/addDevice?astat=template&data=<%= template.uuid %>"><i class="icmn-pencil"></i></a> <a title="Duplicate Template" href="/dashboard/addDevice?astat=template-duplicate&data=<%= template.uuid %>"><i class="icmn-copy4"></i></a> <button onclick='deleteTemplate(<%- JSON.stringify(template.uuid) %>)'>Delete</button></td></tr><% }) %></tbody></table></div></div>
<script>async function deleteTemplate(id){if(!confirm('Delete this template?'))return;const r=await fetch('/api/templates/'+encodeURIComponent(id),{method:'DELETE'});if(r.ok)location.reload();else alert((await r.json()).message);}</script></body></html>
