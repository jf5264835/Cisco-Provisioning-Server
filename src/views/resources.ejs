<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CPM Dashboard - Resources (<%= username %>)</title>

    <!--STYLES-->
    <link rel="stylesheet" href="/shared/css/master-resources.css" />

    <!--ALL IMPORT-->
    <link rel="stylesheet" href="/shared/ico/icons.css" />
    <link rel="stylesheet" href="/shared/css/badges.css" />
    <link rel="stylesheet" href="/shared/css/datatables.min.css" />
    <link rel="stylesheet" href="/shared/css/toastify.css" />
    <link rel="stylesheet" href="/shared/css/normalize.css" />

    <!--Define Safari/IOS Color Scheme-->
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
</head>

<body>


    <!--Navigation Elements-->
    <nav>
        <span onclick="window.location='/dashboard/settings'"><%= username %>&ensp;<i class="icmn-user3"></i></span>

        <span onclick="window.location='/dashboard/settings'">Settings&ensp;<i class="icmn-cog"></i></span>

        <span onclick="window.location = ('/logout');">Logout&ensp;<i class="icmn-exit3"></i></span>

        <!--DO NOT REMOVE THIS (FIXES RIGHT PADDING ISSUE WITH FLEX)-->
        <span>&nbsp;</span> 
    </nav>

    <%- include('partials/sidebar.ejs') %>

    <%- include('partials/mobile-sidebar.ejs') %>

    <div class="main" id="main">
        <%- include('partials/logobar.ejs') %>
        <!--End Navigation Elements-->

        <div class="menuItem" id="menuItem">
            <button onclick="document.getElementById('wallpaperImage').click();"><i class="icmn-plus3"></i> Add Wallpaper</button>
            <button onclick="document.getElementById('ringtoneFile').click();"><i class="icmn-music"></i> Add Ringtone</button>
            <button onclick="location.reload()"><i class="icmn-loop3"></i> Refresh</button>
        </div>
        <div class="internal">
            <h1>Static Resources</h1>
            <p>Assign & Manage embedded static resources, such as Dialplans, Wallpapers, Ringtones, and Firmware Loads.</p>
        
            <div class="tabMenu">
                <div class="tabContainer">
                    <button type="button" class="item active" data-resource-tab="globalResources"><i class="icmn-users4"></i> Global Resources</button>
                    <button type="button" class="item" data-resource-tab="dialTemplate"><i class="icmn-phone-wave"></i> Dial Template</button>
                    <button type="button" class="item" data-resource-tab="appDialRules"><i class="icmn-file-xml"></i> App Dial Rules</button>

                </div>
                <div class="tabBody" id="globalResources" data-resource-panel>
                    <p><i class="icmn-info"></i> Resources created within this group will be available to all devices created within CPM, including devices that haven't been assigned a group.</p>

                    <section class="resourceSection">
                        <div class="sectionHeader">
                            <div>
                                <h2>Wallpapers</h2>
                                <p>Cisco 8841/8845/8851/8861/8865 wallpapers use 800x480 PNG images. Thumbnails are optional; Cisco recommends 139x109 PNG.</p>
                            </div>
                            <a href="/Desktops/800x480x24/List.xml" target="_blank">Open Cisco List.xml</a>
                        </div>

                        <form id="wallpaperForm" class="resourceForm">
                            <label for="wallpaperName">Name</label>
                            <input id="wallpaperName" name="name" type="text" placeholder="Lobby Wallpaper" required>

                            <label for="wallpaperResolution">Phone Family</label>
                            <select id="wallpaperResolution" name="resolution">
                                <option value="800x480x24">8800 Series Color (800x480x24)</option>
                            </select>

                            <label for="wallpaperImage">Wallpaper Image</label>
                            <input id="wallpaperImage" name="image" type="file" accept="image/png" required>

                            <label for="wallpaperThumbnail">Thumbnail</label>
                            <input id="wallpaperThumbnail" name="thumbnail" type="file" accept="image/png">

                            <button type="submit"><i class="icmn-upload3"></i> Upload Wallpaper</button>
                        </form>

                        <div id="wallpaperStatus" class="resourceStatus"></div>
                        <div id="wallpaperGrid" class="wallpaperGrid"></div>
                    </section>

                    <section class="resourceSection">
                        <div class="sectionHeader">
                            <div>
                                <h2>Ringtones</h2>
                                <p>Upload Cisco .rwb/.raw files directly, or upload common audio and CPM will convert it. Cisco 8800 series phones use wideband .rwb files listed in Ringlist-wb.xml.</p>
                            </div>
                            <div class="sectionLinks">
                                <a href="/Ringlist-wb.xml" target="_blank">Open Ringlist-wb.xml</a>
                                <a href="/Ringlist.xml" target="_blank">Open Ringlist.xml</a>
                            </div>
                        </div>

                        <form id="ringtoneForm" class="resourceForm ringtoneForm">
                            <label for="ringtoneName">Display Name</label>
                            <input id="ringtoneName" name="name" type="text" maxlength="25" placeholder="Lobby Ring" required>

                            <label for="ringtoneType">Phone Family</label>
                            <select id="ringtoneType" name="type">
                                <option value="wideband">8800 Series Wideband (.rwb)</option>
                                <option value="narrowband">Classic Narrowband (.raw)</option>
                            </select>

                            <label for="ringtoneFile">Ringtone File</label>
                            <input id="ringtoneFile" name="ringtone" type="file" accept=".rwb,.raw,.aac,.flac,.m4a,.mp3,.oga,.ogg,.opus,.wav,.webm,audio/*" required>

                            <button type="submit"><i class="icmn-upload3"></i> Upload Ringtone</button>
                        </form>

                        <div id="ringtoneStatus" class="resourceStatus"></div>
                        <div id="ringtoneGrid" class="resourceGrid"></div>
                    </section>

                    <section class="resourceSection">
                        <div class="sectionHeader"><div><h2>Global Dialing Resources</h2><p>Build the global DialTemplate.xml digit patterns or edit AppDialRules.xml directly. Both files are XML-validated before an atomic save.</p></div><div class="sectionLinks"><a href="/DialTemplate.xml" target="_blank">Open DialTemplate.xml</a><a href="/AppDialRules.xml" target="_blank">Open AppDialRules.xml</a></div></div>
                        <h3>Dial template rules</h3>
                        <div id="dialRuleRows" class="dialRuleRows"></div>
                        <button type="button" id="addDialRule"><i class="icmn-plus3"></i> Add rule</button>
                        <button type="button" id="saveDialTemplate"><i class="icmn-floppy-disk"></i> Save DialTemplate.xml</button>
                        <div id="dialTemplateStatus" class="resourceStatus" role="status"></div>
                        <h3>AppDialRules.xml</h3>
                        <textarea id="appDialRulesXml" class="xmlEditor" spellcheck="false" aria-label="AppDialRules XML"></textarea>
                        <button type="button" id="saveAppDialRules"><i class="icmn-floppy-disk"></i> Validate &amp; Save AppDialRules.xml</button>
                        <div id="appDialRulesStatus" class="resourceStatus" role="status"></div>
                    </section>
                </div>

                <div class="tabBody" id="dialPlan" data-resource-panel hidden>
                    <section class="resourceSection">
                        <div class="sectionHeader"><div><h2>Global Dial Plan</h2><p>Each rule maps a Cisco digit pattern to a timeout and optional rewrite or line. Rules are evaluated by the phone in file order.</p></div><div class="sectionLinks"><a href="https://usecallmanager.nz/dial-template.html" target="_blank" rel="noopener">Cisco pattern guide</a><a href="/DialTemplate.xml" target="_blank">Open XML</a></div></div>
                        <div class="dialHelp"><strong>Pattern symbols:</strong> digits match themselves; <code>.</code> matches one digit, <code>*</code> matches zero or more digits, <code>\*</code> matches a literal star, and <code>,</code> plays a secondary dial tone. A lower timeout places the call sooner.</div>
                        <div class="versionStampRow"><label for="dialVersionStamp">Version stamp</label><input id="dialVersionStamp" type="text" aria-describedby="versionStampHelp"><button type="button" id="generateVersionStamp">Generate UUID</button><small id="versionStampHelp">Change this when publishing a new plan so phones can identify the revision.</small></div>
                        <h3>Dial rules</h3>
                        <div class="dialRuleHeadings" aria-hidden="true"><span>Common rule</span><span>Match pattern</span><span>Timeout</span><span>Rewrite</span><span>Line</span><span></span></div>
                        <div id="dialRuleRows" class="dialRuleRows"></div>
                        <button type="button" id="addDialRule"><i class="icmn-plus3"></i> Add rule</button>
                        <button type="button" id="saveDialTemplate"><i class="icmn-floppy-disk"></i> Save DialTemplate.xml</button>
                        <div id="dialTemplateStatus" class="resourceStatus" role="status"></div>
                        <details class="advancedDialRules"><summary>Advanced: AppDialRules.xml editor</summary><p>Use this only for models that consume application dial rules. The XML root and well-formedness are validated before saving.</p>
                        <textarea id="appDialRulesXml" class="xmlEditor" spellcheck="false" aria-label="AppDialRules XML"></textarea>
                        <button type="button" id="saveAppDialRules"><i class="icmn-floppy-disk"></i> Validate &amp; Save AppDialRules.xml</button>
                        <div id="appDialRulesStatus" class="resourceStatus" role="status"></div>
                        </details>
                    </section>
                </div>

                <div class="tabBody" id="dialTemplate" data-resource-panel hidden>
                    <section class="resourceSection">
                        <div class="sectionHeader"><div><h2>Global Dial Plan</h2><p>Each rule maps a Cisco digit pattern to a timeout and optional rewrite or line. Rules are evaluated by the phone in file order.</p></div><div class="sectionLinks"><a href="https://usecallmanager.nz/dial-template.html" target="_blank" rel="noopener">Cisco pattern guide</a><a href="/DialTemplate.xml" target="_blank">Open XML</a></div></div>
                        <div class="dialHelp"><strong>Pattern symbols:</strong> digits match themselves; <code>.</code> matches one digit, <code>*</code> matches zero or more digits, <code>\*</code> matches a literal star, and <code>,</code> plays a secondary dial tone. A lower timeout places the call sooner.</div>
                        <div class="versionStampRow"><label for="dialVersionStamp">Version stamp</label><input id="dialVersionStamp" type="text" aria-describedby="versionStampHelp"><button type="button" id="generateVersionStamp">Generate UUID</button><small id="versionStampHelp">Change this when publishing a new plan so phones can identify the revision.</small></div>
                        <h3>Dial rules</h3>
                        <div class="dialRuleHeadings" aria-hidden="true"><span>Common rule</span><span>Match pattern</span><span>Timeout</span><span>Rewrite</span><span>Line</span><span></span></div>
                        <div id="dialRuleRows" class="dialRuleRows"></div>
                        <button type="button" id="addDialRule"><i class="icmn-plus3"></i> Add rule</button>
                        <button type="button" id="saveDialTemplate"><i class="icmn-floppy-disk"></i> Save DialTemplate.xml</button>
                        <div id="dialTemplateStatus" class="resourceStatus" role="status"></div>
                    </section>
                </div>
                <div class="tabBody" id="appDialRules" data-resource-panel hidden>
                    <section class="resourceSection">
                        <div class="sectionHeader"><div><h2>App Dial Rules</h2><p>Raw AppDialRules.xml editor for phone models that consume application dial rules.</p></div><a href="/AppDialRules.xml" target="_blank">Open XML</a></div>
                        <textarea id="appDialRulesXml" class="xmlEditor" spellcheck="false" aria-label="AppDialRules XML"></textarea>
                        <button type="button" id="saveAppDialRules"><i class="icmn-floppy-disk"></i> Validate &amp; Save AppDialRules.xml</button>
                        <div id="appDialRulesStatus" class="resourceStatus" role="status"></div>
                    </section>
                </div>

                <div class="tabBody" id="dialTemplate" data-resource-panel hidden>
                    <section class="resourceSection">
                        <div class="sectionHeader"><div><h2>Global Dial Plan</h2><p>Each rule maps a Cisco digit pattern to a timeout and optional rewrite or line. Rules are evaluated by the phone in file order.</p></div><div class="sectionLinks"><a href="https://usecallmanager.nz/dial-template.html" target="_blank" rel="noopener">Cisco pattern guide</a><a href="/DialTemplate.xml" target="_blank">Open XML</a></div></div>
                        <div class="dialHelp"><strong>Pattern symbols:</strong> digits match themselves; <code>.</code> matches one digit, <code>*</code> matches zero or more digits, <code>\*</code> matches a literal star, and <code>,</code> plays a secondary dial tone. A lower timeout places the call sooner.</div>
                        <div class="versionStampRow"><label for="dialVersionStamp">Version stamp</label><input id="dialVersionStamp" type="text" aria-describedby="versionStampHelp"><button type="button" id="generateVersionStamp">Generate UUID</button><small id="versionStampHelp">Change this when publishing a new plan so phones can identify the revision.</small></div>
                        <h3>Dial rules</h3>
                        <div class="dialRuleHeadings" aria-hidden="true"><span>Common rule</span><span>Match pattern</span><span>Timeout</span><span>Rewrite</span><span>Line</span><span></span></div>
                        <div id="dialRuleRows" class="dialRuleRows"></div>
                        <button type="button" id="addDialRule"><i class="icmn-plus3"></i> Add rule</button>
                        <button type="button" id="saveDialTemplate"><i class="icmn-floppy-disk"></i> Save DialTemplate.xml</button>
                        <div id="dialTemplateStatus" class="resourceStatus" role="status"></div>
                    </section>
                </div>
                <div class="tabBody" id="appDialRules" data-resource-panel hidden>
                    <section class="resourceSection">
                        <div class="sectionHeader"><div><h2>App Dial Rules</h2><p>Raw AppDialRules.xml editor for phone models that consume application dial rules.</p></div><a href="/AppDialRules.xml" target="_blank">Open XML</a></div>
                        <textarea id="appDialRulesXml" class="xmlEditor" spellcheck="false" aria-label="AppDialRules XML"></textarea>
                        <button type="button" id="saveAppDialRules"><i class="icmn-floppy-disk"></i> Validate &amp; Save AppDialRules.xml</button>
                        <div id="appDialRulesStatus" class="resourceStatus" role="status"></div>
                    </section>
                </div>

                <div class="tabBody" id="dialTemplate" data-resource-panel hidden>
                    <section class="resourceSection">
                        <div class="sectionHeader"><div><h2>Global Dial Template</h2><p>Each rule maps a Cisco digit pattern to a timeout and optional rewrite or line. Rules are evaluated by the phone in file order.</p></div><div class="sectionLinks"><a href="https://usecallmanager.nz/dial-template.html" target="_blank" rel="noopener">Cisco pattern guide</a><a href="/DialTemplate.xml" target="_blank">Open XML</a></div></div>
                        <div class="dialHelp"><strong>Pattern symbols:</strong> digits match themselves; <code>.</code> matches one digit, <code>*</code> matches zero or more digits, <code>\*</code> matches a literal star, and <code>,</code> plays a secondary dial tone. A lower timeout places the call sooner.</div>
                        <div class="versionStampRow"><label for="dialVersionStamp">Version stamp</label><input id="dialVersionStamp" type="text" aria-describedby="versionStampHelp"><button type="button" id="generateVersionStamp">Generate UUID</button><small id="versionStampHelp">Change this when publishing a new plan so phones can identify the revision.</small></div>
                        <h3>Dial rules</h3>
                        <div class="dialRuleHeadings" aria-hidden="true"><span>Common rule</span><span>Match pattern</span><span>Timeout</span><span>Rewrite</span><span>Line</span><span></span></div>
                        <div id="dialRuleRows" class="dialRuleRows"></div>
                        <button type="button" id="addDialRule"><i class="icmn-plus3"></i> Add rule</button>
                        <button type="button" id="saveDialTemplate"><i class="icmn-floppy-disk"></i> Save DialTemplate.xml</button>
                        <div id="dialTemplateStatus" class="resourceStatus" role="status"></div>
                    </section>
                </div>
                <div class="tabBody" id="appDialRules" data-resource-panel hidden>
                    <section class="resourceSection">
                        <div class="sectionHeader"><div><h2>App Dial Rules</h2><p>Raw AppDialRules.xml editor for phone models that consume application dial rules.</p></div><a href="/AppDialRules.xml" target="_blank">Open XML</a></div>
                        <textarea id="appDialRulesXml" class="xmlEditor" spellcheck="false" aria-label="AppDialRules XML"></textarea>
                        <button type="button" id="saveAppDialRules"><i class="icmn-floppy-disk"></i> Validate &amp; Save AppDialRules.xml</button>
                        <div id="appDialRulesStatus" class="resourceStatus" role="status"></div>
                    </section>
                </div>
            </div>

        
        </div>
        
    </div>
    

    <footer>
        <span><i class='icmn-lock2'></i> v0.0.1 <span data-after-text="Online" data-after-type="green-pill"></span></span>
    </footer>


    <script src="/shared/js/toast-support.js"></script>

    <script src="/shared/js/master-resources.js"></script>
    <script src="/shared/js/toastify.min.js"></script>
    <script src="/shared/js/responsiveAdjust.js"></script>
    <script src="/shared/js/jquery-3.7.0.min.js"></script>
    <script src="/shared/js/jquery-migrate-3.4.1.min.js"></script>
    <script src="/shared/js/copier.js"></script>


    <script src="/shared/js/datatables.min.js"></script>
    <script src="/shared/js/dt-utils.js" defer></script>

    <script src="/shared/js/clocksync.js" defer></script>
</body>

</html>
